+#!/usr/bin/env python
+from resource_management import *
+import grp, pwd
+import os
+
+class Master(Script):
+    def install(self, env):
+        import params
+        env.set_params(params)
+        self.install_packages(env)
+        self.configure(env)
+
+    def configure(self, env):
+        import params
+        env.set_params(params)
+        try:
+            grp.getgrnam(params.node_exporter_group)
+        except KeyError:
+            Group(
+                group_name = params.node_exporter_group,
+                ignore_failures = True
+                )
+        try:
+            pwd.getpwnam(params.node_exporter_user)
+        except KeyError:
+            User(
+                username = params.node_exporter_user,
+                groups = [params.node_exporter_group],
+                ignore_failures = True
+                )
+
+        File(format("/etc/default/sdp_node_exporter"),
+             content = Template('sdp_node_exporter').get_content(),
+             owner = params.node_exporter_user,
+             group = params.node_exporter_group,
+             mode = 0o644
+        )
+
+        File(format("/usr/lib/systemd/system/sdp_node_exporter.service"),
+             content = Template('sdp_node_exporter.service').get_content(),
+             owner = "root",
+             group = "root",
+             mode = 0o644
+        )
+
+        Execute("systemctl daemon-reload", user="root")
+
+    def start(self, env, upgrade_type=None):
+        import params
+        env.set_params(params)
+        self.configure(env)
+
+        Directory(os.path.dirname(params.node_exporter_pid_file),
+                  owner = params.node_exporter_user,
+                  group = params.node_exporter_group,
+                  create_parents = True,
+                  mode = 0o755
+        )
+
+        File(params.node_exporter_pid_file, action = "delete")
+        Execute(format("systemctl start sdp_node_exporter"),user="root")
+        Execute("systemctl show -p MainPID sdp_node_exporter | cut -d'=' -f2 > " + params.node_exporter_pid_file, user="root")
+        File(params.node_exporter_pid_file,
+             owner = params.node_exporter_user,
+             group = params.node_exporter_group,
+             mode = 0o644)
+
+    def stop(self, env, upgrade_type=None):
+        import params
+        env.set_params(params)
+        Execute ("systemctl stop sdp_node_exporter", user="root", ignore_failures=True)
+        File(params.node_exporter_pid_file, action = "delete")
+
+    def status(self, env):
+        import params
+        env.set_params(params)
+        # use built-in method to check status using pidfile
+        check_process_status(params.node_exporter_pid_file)
+
+
+if __name__ == "__main__":
+    Master().execute()
