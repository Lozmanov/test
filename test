+        File(format("{params.vector_metrics_etc_dir}/vector.yaml"),
+            content=InlineTemplate(params.vector_metrics_content),
+            owner=params.vector_user,
+            group=params.vector_group,
+            mode=0o600
+        )
+
+        Directory(params.vector_metrics_data_dir,
+                  owner=params.vector_user,
+                  group=params.vector_group,
+                  create_parents=True)
+
+        Execute("systemctl daemon-reload", user="root")
+
+    def start(self, env, upgrade_type=None):
+        import params
+        env.set_params(params)
+        if params.vector_metrics_remote_write_url == '""':
+            raise Fail("vector-metrics/remote_write_url is not set")
+        self.configure(env)
+        try:
+            Execute("systemctl start vector-metrics", user="root")
+            Execute("systemctl show -p MainPID vector-metrics | cut -d'=' -f2 > " + params.vector_metrics_pid_file, user="root")
+        except:
+            Execute("journalctl -u vector-metrics.service --no-pager -n 40",
+            logoutput = True,
+            ignore_failures = True,
+            user = "root",
+            )
+            raise
+
+    def stop(self, env, upgrade_type=None):
+        import params
+        env.set_params(params)
+        Execute("systemctl stop vector-metrics", user="root")
+        File(params.vector_metrics_pid_file, action="delete")
+
+    def status(self, env):
+        import params
+        env.set_params(params)
+        check_process_status(params.vector_metrics_pid_file)
+
+
+if __name__ == "__main__":
+    Master().execute()
