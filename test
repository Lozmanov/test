+# -*- mode: conf -*-
+
+[Unit]
+Description=Prometheus exporter for machine metrics, written in Go with pluggable metric collectors.
+Documentation=https://github.com/prometheus/node_exporter
+After=network.target
+
+[Service]
+User={{node_exporter_user}}
+Group={{node_exporter_group}}
+EnvironmentFile=-/etc/default/sdp_node_exporter
+ExecStart=/usr/share/sdp_node_exporter/node_exporter $NODE_EXPORTER_OPTS
+ExecReload=/bin/kill -HUP $MAINPID
+Restart=on-failure
+RestartSec=5s
+
+[Install]
+WantedBy=multi-user.target
