import groovy.json.JsonSlurper
import groovy.json.JsonOutput

/* =====================================================================================================================
   RLM-сценарий: подготовка k8s-кластера к установке Apache Ozone.

   Чарт ozone не создаёт PVC, поэтому StorageClass'ы и PVC должны существовать
   в кластере до `helm install ozone`. Три шага подготовки:
     1. INSTALL_LVM_OPERATOR — PSA-лейблы на ns оператора + helm install чарта;
     2. CREATE_LVM_CLUSTER   — CR LVMCluster с deviceClasses (нода × диск) →
                               оператор сам создаёт StorageClass lvms-<deviceClass>;
     3. CREATE_PVC           — PVC с именами, которые ожидает чарт.

   Namespace'ы (оператора и ozone) сценарий не создаёт: их заводит команда стенда.

   Имена PVC задаёт чарт ozone, имена StorageClass — оператор (по имени deviceClass,
   без префикса); менять схему здесь в одностороннем порядке нельзя. scNamePrefix
   входит только в имена PVC:
     deviceClass  = <diskIndex>-<nodeShortName>                  lv01-pplos-kub000401
     StorageClass = <diskIndex>-<nodeShortName>                  lv01-pplos-kub000401
     PVC om       = pvc-om-<scNamePrefix>-<omDiskIndex>-<node>   pvc-om-lvms-lv01-pplos-kub000401
     PVC scm      = pvc-scm-<scNamePrefix>-<scmDiskIndex>-<node>
     PVC datanode = pvc-dn-<scNamePrefix>-<diskIndex>-<node>

   Сценарий работает под готовыми ServiceAccount стенда и никаких ролей не создаёт.
   Каждый шаг логинится своим токеном (см. SA_TOKENS), чтобы права выдавались по
   принципу наименьших привилегий.

   Все шаги идемпотентны: повторный запуск без изменений во входных данных ничего
   не создаёт, не меняет и не удаляет — установленный оператор пропускается,
   совпавший с раскладкой LVMCluster не применяется, создаются только недостающие PVC.
   ===================================================================================================================== */

/* --- Не сериализуемая функция парсинга JSON ------------------------------------------------------------------------ */
@NonCPS
def parse_result(data) {
    return new JsonSlurper().parseText(data)
}

/* --- Ошибка выполнения сценария RLM ------------------------------------------------------------------------------- */
def rlm_error() {
    if (print_error_tag) {
        println("""RLM.ERROR.START $error RLM.ERROR.END""")
    } else {
        println("")
    }
}

/* --- Разбор списка: запятая / перевод строки / пробел -------------------------------------------------------------- */
@NonCPS
def split_list(value) {
    if (!value) { return [] }
    return value.toString().split(/[,\s]+/).collect { it.trim() }.findAll { it }
}

/* --- Короткое имя ноды — так же, как regexFind "[^.]+" в чарте ----------------------------------------------------- */
@NonCPS
def short_name(node) {
    return node.toString().split(/\./)[0]
}

/* --- Хост кластера из ссылки на консоль карточки ИР ------------------------------------------------------------------
       https://console.bdq2i0fy.k8s.omega.sbrf.ru/ → bdq2i0fy.k8s.omega.sbrf.ru --------------------------------------- */
@NonCPS
def cluster_host(url) {
    return url.toString().trim()
              .replaceFirst(/^https?:\/\//, '')
              .replaceFirst(/[:\/].*$/, '')
              .replaceFirst(/^console\./, '')
}

/* --- ctrl-ноды: om + scm без дублей ------------------------------------------------------------------------------------
       Обязательно @NonCPS: unique{} не входит в CPS-трансформацию workflow-cps, и в
       pipeline-коде такой вызов молча обрывается на первом элементе, возвращая результат
       closure — строку вместо списка (JENKINS-26481). ---------------------------------------------------------------- */
@NonCPS
def ctrl_nodes(List om, List scm) {
    return (om + scm).unique { short_name(it) }
}

/* --- Индекс диска по позиции в списке путей: 1 → lv01 ------------------------------------------------------------- */
@NonCPS
def disk_index(int position) {
    return String.format('lv%02d', position)
}

/* --- Получение входных данных ------------------------------------------------------------------------------------- */
def get_json_data(json_data) {

    println "\n --- JOB_INFO: Информация о запуске сценария  --- \n"

    def result = parse_result(json_data)
    RLM_ID     = result.id

    println '\n --- JOB_INFO: Получение входных данных --- \n'
    println(result.payload.idm_role)
    if (result.payload.idm_role == "test") {
        TEST = true
        return 0
    }

    def p = result.payload
    currentBuild.displayName = """#${currentBuild.number} RLM-ID: $RLM_ID"""

    ACTION  = p.action ?: 'PREPARE_ALL'
    DRY_RUN = (p.dryRun == true || p.dryRun == 'true')
    if (!(ACTION in ACTIONS)) {
        error("""RLM.ERROR.START Неизвестный action '${ACTION}', допустимо: ${ACTIONS.join(', ')} RLM.ERROR.END""")
    }

    /* Адрес кластера берём из карточки ИР, выбранной в заявке (records[0]): в
       invir_tps_resource_path лежит ссылка на консоль, api-хост тот же с префиксом
       api. Так новый стенд не требует правки джобы и сценария.

       Из короткого имени кластера складываются имена jenkins-кредов с токенами SA —
       по одному на роль (operator / storage / pvc, см. README). Ни id креда, ни
       api-url из payload не принимаем: id креда дал бы возможность прочитать любой
       доступный джобе secret text, api-url — увести токен на чужой сервер. */
    def record = result.records ? result.records[0] : null
    def console_url = record?.invir_tps_resource_path ? record.invir_tps_resource_path[0] : null
    if (!console_url) {
        error("""RLM.ERROR.START В заявке нет адреса кластера (records[0].invir_tps_resource_path) RLM.ERROR.END""")
    }

    K8S_CLUSTER = cluster_host(console_url)
    CLUSTER_ID  = K8S_CLUSTER.split(/\./)[0]
    K8S_STAND   = record.invstend_stend_name ? record.invstend_stend_name[0] : CLUSTER_ID
    API_URL     = "https://api.${K8S_CLUSTER}:6443"
    SA_TOKENS   = [operator: "ozone_k8s_${CLUSTER_ID}_operator_token".toString(),
                   storage : "ozone_k8s_${CLUSTER_ID}_storage_token".toString(),
                   pvc     : "ozone_k8s_${CLUSTER_ID}_pvc_token".toString()]

    // Namespace'ы заводит команда стенда, поэтому оба приходят из формы
    OZONE_NS = p.namespace ?: ''
    LVM_NS   = p.lvmNamespace ?: 'lvm-operator'

    finalData.cluster = K8S_CLUSTER

    OM_NODES            = split_list(p.omNodes)
    SCM_NODES           = split_list(p.scmNodes)
    DN_NODES            = split_list(p.datanodeNodes)
    CTRL_NODES          = ctrl_nodes(OM_NODES, SCM_NODES)
    NODE_LABEL_SELECTOR = p.nodeLabelSelector ?: ''
    NODE_EXCLUDE_REGEX  = p.nodeExcludeRegex  ?: ''

    // Позиция пути в списке задаёт индекс тома: первый путь → lv01, второй → lv02
    CTRL_DISK_PATHS = split_list(p.ctrlDiskPaths)
    DN_DISK_PATHS   = split_list(p.datanodeDiskPaths)
    OM_DISK_INDEX   = p.omDiskIndex  ?: 'lv01'
    SCM_DISK_INDEX  = p.scmDiskIndex ?: 'lv02'

    OM_PVC_SIZE  = (p.omPvcSize       ?: '100Gi').toString()
    SCM_PVC_SIZE = (p.scmPvcSize      ?: '100Gi').toString()
    DN_PVC_SIZE  = (p.datanodePvcSize ?: '1Ti').toString()

    SC_NAME_PREFIX = p.scNamePrefix ?: 'lvms'
    PVC_QUOTA      = (p.pvcQuota ?: 0) as Integer

    println """
        --- JOB_INFO: Параметры запуска ---
        action                : ${ACTION}${DRY_RUN ? ' (dry-run)' : ''}
        стенд                 : ${K8S_STAND}
        api                   : ${API_URL}
        ns ozone              : ${OZONE_NS}
        ns оператора          : ${LVM_NS}
        чарт оператора        : ${CHART_PATH}
        ноды om / scm         : ${OM_NODES.size()} / ${SCM_NODES.size()}
        ноды datanode         : ${DN_NODES ? DN_NODES.size().toString() : 'авто-дискаверинг'}
        диски ctrl / datanode : ${CTRL_DISK_PATHS.size()} / ${DN_DISK_PATHS.size()}
        префикс в именах PVC  : ${SC_NAME_PREFIX}
        размеры PVC           : om=${OM_PVC_SIZE} scm=${SCM_PVC_SIZE} dn=${DN_PVC_SIZE}
        квота PVC в ns        : ${PVC_QUOTA ?: 'не менять'}
    """
}

/* --- Проверки, которые не выразить сериализатором RLM -------------------------------------------------------------- */
def validate_input() {
    def problems = []

    if (ACTION in NODE_ACTIONS) {
        // ns ozone нужен всем действиям с PVC, в том числе RENDER_ONLY: он попадает в манифесты
        if (!OZONE_NS)         { problems << "не задан namespace Ozone" }
        if (!OM_NODES)         { problems << "не заданы omNodes" }
        if (!SCM_NODES)        { problems << "не заданы scmNodes" }
        if (!CTRL_DISK_PATHS)  { problems << "не заданы ctrlDiskPaths (диски под om/scm)" }
        if (!DN_DISK_PATHS)    { problems << "не заданы datanodeDiskPaths (диски под datanode)" }
        if (ACTION == 'RENDER_ONLY' && !DN_NODES) {
            problems << "RENDER_ONLY не обращается к кластеру — задайте datanodeNodes явно"
        }
        if (OM_DISK_INDEX == SCM_DISK_INDEX) {
            problems << "omDiskIndex и scmDiskIndex совпадают (${OM_DISK_INDEX}) — om и scm заняли бы один том"
        }
        if (CTRL_DISK_PATHS) {
            def available = []
            for (int i = 1; i <= CTRL_DISK_PATHS.size(); i++) { available << disk_index(i) }
            if (!(OM_DISK_INDEX in available)) {
                problems << "omDiskIndex=${OM_DISK_INDEX} вне списка ctrlDiskPaths (доступно ${available.join(', ')})"
            }
            if (!(SCM_DISK_INDEX in available)) {
                problems << "scmDiskIndex=${SCM_DISK_INDEX} вне списка ctrlDiskPaths (доступно ${available.join(', ')})"
            }
        }
    }

    if (problems) {
        error("""RLM.ERROR.START Ошибка входных данных: ${problems.join('; ')} RLM.ERROR.END""")
    }
}

/* --- Выполнение шага под токеном своей роли: operator / storage / pvc ------------------------------------------------
       set +x обязателен: sh-степ Jenkins выполняется как `bash -xe`, то есть по умолчанию
       печатает каждую команду перед запуском, и строка с токеном ушла бы в консоль.
       Токен подставляет bash из переменной окружения, а не Groovy: интерполяция секрета
       в строку скрипта — то, на что Jenkins ругается «A secret was passed to an insecure
       Groovy interpolation method», и она же ломает маскирование `****` в логе.
       tr вместо .trim(): в креде может оказаться перевод строки, а он ломает login. ----------------- */
def with_kube(String role, Closure body) {
    println "\n --- JOB_INFO: шаг под ролью '${role}', кред ${SA_TOKENS[role]} --- \n"
    withCredentials([string(credentialsId: "${SA_TOKENS[role]}", variable: 'OC_TOKEN')]) {
        sh """
            set +x
            token=\$(echo -n "\$OC_TOKEN" | tr -d '[:space:]')
            oc login --token="\$token" --server=${API_URL} > /dev/null
        """
        body()
    }
}

/* --- Отсев ctrl-нод и исключений из вывода `kubectl get nodes` ---------------------------------------------------------
       @NonCPS, как и остальная работа с closure: ctrl-ноды под datanode не отдаём (на них
       другой набор дисков), порядок фиксируем — он же уйдёт в datanode.nodeHostnames чарта. -------------------------- */
@NonCPS
def filter_datanode_nodes(List nodes) {
    def ctrl = CTRL_NODES.collect { short_name(it) } as Set
    def out = nodes.findAll { !ctrl.contains(short_name(it)) }
    if (NODE_EXCLUDE_REGEX) {
        out = out.findAll { !(short_name(it) ==~ /.*(${NODE_EXCLUDE_REGEX}).*/) }
    }
    return out.sort()
}

/* --- Авто-дискаверинг datanode-нод (вызывается, когда datanodeNodes не задан) --------------------------------------- */
def resolve_datanode_nodes() {
    def selector = NODE_LABEL_SELECTOR ? "-l '${NODE_LABEL_SELECTOR}'" : ''
    def raw = sh(script: "kubectl get nodes ${selector} --no-headers -o custom-columns=NAME:.metadata.name",
                 returnStdout: true).trim()
    DN_NODES = filter_datanode_nodes(split_list(raw))

    println "\n --- JOB_INFO: авто-дискаверинг datanode-нод: ${DN_NODES.size()} шт. --- \n"
    println DN_NODES.join('\n')
}

/* --- Раскладка «нода × диск» → deviceClasses ----------------------------------------------------------------------- */
@NonCPS
def device_plan() {
    def out = []
    // Имена собираем в String, а не GString: они же — ключи сверки с состоянием кластера
    def add = { node, paths ->
        paths.eachWithIndex { path, i ->
            def name = "${disk_index(i + 1)}-${short_name(node)}".toString()
            out << [name: name, node: node, path: path]
        }
    }
    CTRL_NODES.each { add(it, CTRL_DISK_PATHS) }
    DN_NODES.each   { add(it, DN_DISK_PATHS) }
    return out
}

/* --- Раскладка PVC ----------------------------------------------------------------------------------------------------
       Имя PVC и имя StorageClass строятся по-разному, и scNamePrefix входит только в первое:
       имя PVC задаёт чарт ozone (`pvc-<role>-<namePrefix>-<diskIndex>-<node>`), а StorageClass
       называет оператор — по имени deviceClass, то есть `<diskIndex>-<node>` без префикса. ----------------------------- */
@NonCPS
def volume_plan() {
    def out = []
    def add = { role, component, node, diskIndex, size ->
        def sc = "${diskIndex}-${short_name(node)}".toString()
        out << [name: "pvc-${role}-${SC_NAME_PREFIX}-${sc}".toString(), sc: sc, component: component, size: size]
    }
    OM_NODES.each  { add('om',  'ozone-manager', it, OM_DISK_INDEX, OM_PVC_SIZE) }
    SCM_NODES.each { add('scm', 'ozone-storage-container-manager', it, SCM_DISK_INDEX, SCM_PVC_SIZE) }
    DN_NODES.each { node ->
        (1..DN_DISK_PATHS.size()).each { add('dn', 'ozone-datanode', node, disk_index(it), DN_PVC_SIZE) }
    }
    return out
}

/* --- Сверка раскладки с deviceClasses, которые уже описаны в CR ------------------------------------------------------
       json — `kubectl get lvmcluster -o jsonpath={.spec.storage.deviceClasses}`, пусто если CR нет. --------------- */
@NonCPS
def device_diff(List devices, String json) {
    def current = [:]
    if (json) {
        new JsonSlurper().parseText(json).each { d ->
            def node = d.nodeSelector?.nodeSelectorTerms?.getAt(0)?.matchExpressions?.getAt(0)?.values?.getAt(0)
            current[d.name] = "${d.deviceSelector?.paths?.getAt(0)}@${node}".toString()
        }
    }
    def wanted = devices.collectEntries { [(it.name): "${it.path}@${it.node}".toString()] }
    return [
        total  : current.size(),
        added  : (wanted.keySet()  - current.keySet()) as List,
        dropped: (current.keySet() - wanted.keySet())  as List,
        moved  : wanted.findAll { name, disk -> current[name] && current[name] != disk }.keySet() as List
    ]
}

/* --- Сверка раскладки с PVC, которые уже есть в ns -------------------------------------------------------------------
       raw — `kubectl get pvc` тремя колонками: имя, storageClass, размер. ------------------------------------------- */
@NonCPS
def volume_diff(List volumes, String raw) {
    def current = [:]
    raw.split(/\n/).each { line ->
        def field = line.trim().split(/\s+/)
        if (field.size() == 3) { current[field[0]] = "${field[1]}@${field[2]}".toString() }
    }
    return [
        missing: volumes.findAll { !current.containsKey(it.name) },
        wrong  : volumes.findAll { current[it.name] && current[it.name] != "${it.sc}@${it.size}".toString() }*.name
    ]
}

/* --- Рендер CR LVMCluster --------------------------------------------------------------------------------------------
       Текст собирается списком строк + join: StringBuilder << запрещён sandbox'ом Jenkins
       (нет в белом списке script-security), а разрешать его — административное согласование. ------------------------ */
@NonCPS
def render_lvmcluster(List devices) {
    def parts = ["""\
apiVersion: lvm.topolvm.io/v1alpha1
kind: LVMCluster
metadata:
  name: ${LVM_CLUSTER}
  namespace: ${LVM_NS}
spec:
  storage:
    deviceClasses:
"""]
    devices.each { d ->
        parts << """\
      - name: ${d.name}
        fstype: ${FS_TYPE}
        deviceSelector:
          paths:
            - ${d.path}
        nodeSelector:
          nodeSelectorTerms:
            - matchExpressions:
                - key: kubernetes.io/hostname
                  operator: In
                  values:
                    - ${d.node}
        thinPoolConfig:
          name: ${THIN_POOL}
          chunkSize: ${THIN_CHUNK_SIZE}
          chunkSizeCalculationPolicy: Static
          sizePercent: ${THIN_SIZE_PERCENT}
          overprovisionRatio: ${THIN_OVERPROVISION}
"""
    }
    return parts.join('')
}

/* --- Рендер PVC порциями: тысячи объектов одним `apply` не отдаём -------------------------------------------------- */
@NonCPS
def render_pvc_batches(List volumes, int perBatch) {
    return volumes.collate(perBatch).collect { batch ->
        batch.collect { v ->
            """\
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${v.name}
  namespace: ${OZONE_NS}
  labels:
    app.kubernetes.io/managed-by: ${PVC_OWNER}
    app.kubernetes.io/component: ${v.component}
spec:
  accessModes:
    - ReadWriteOncePod
  storageClassName: "${v.sc}"
  resources:
    requests:
      storage: ${v.size}
"""
        }.join('')
    }
}

/* --- Запись PVC порциями в out/; возвращает список файлов -------------------------------------------------------------
       Обычный for, а не eachWithIndex: closure-итерация вокруг степов в CPS-коде не
       выполняется — writeFile внутри closure молча не отрабатывает (та же природа, что
       у unique{}, см. ctrl_nodes). Степы вызываем только из plain-циклов. ------------------------------------------- */
def write_pvc_batches(List volumes) {
    def batches = render_pvc_batches(volumes, PVC_PER_APPLY)
    def files = []
    for (int i = 0; i < batches.size(); i++) {
        def file = "out/pvc-${String.format('%03d', i + 1)}.yaml"
        writeFile file: file, text: batches[i]
        files << file
    }
    return files
}

/* --- Фрагмент values.yaml для чарта ozone -------------------------------------------------------------------------- */
@NonCPS
def render_values() {
    def parts = ["""\
# Сгенерировано RLM-сценарием prepare_ozone_storage.
# Значения ОБЯЗАНЫ совпадать с созданными StorageClass/PVC, иначе pod'ы ozone не
# найдут свои тома, а kubelatte-правило ozone-pvc-mount их не пустит.
global:
  storage:
    mode: storageClass
    storageClass:
      namePrefix: ${SC_NAME_PREFIX}
      om:
        diskIndex: ${OM_DISK_INDEX}
        size: "${OM_PVC_SIZE}"
      scm:
        diskIndex: ${SCM_DISK_INDEX}
        size: "${SCM_PVC_SIZE}"
      datanode:
        size: "${DN_PVC_SIZE}"
        diskIndices:
"""]
    (1..DN_DISK_PATHS.size()).each { parts << "          - ${disk_index(it)}\n" }

    [om: OM_NODES, scm: SCM_NODES, datanode: DN_NODES].each { component, nodes ->
        parts << "\n${component}:\n  replicas: ${nodes.size()}\n  nodeHostnames:\n"
        nodes.each { parts << "    - ${it}\n" }
    }
    return parts.join('')
}

/* --- Применение манифеста. retries > 1 нужен для объектов за вебхуком lvms: он стоит с
       failurePolicy: Fail, а caBundle ему асинхронно прокидывает cainjector cert-manager'а,
       поэтому первый apply сразу после установки оператора может упасть.
       retries передаётся всегда: значение по умолчанию в CPS-методе Groovy порождает
       синтетический метод-обёртку, который не проходит CPS-трансформацию, и вызов
       kube_apply(file) с одним аргументом молча не выполняет тело. --------------------------------------------------- */
def kube_apply(String file, int retries) {
    for (int attempt = 1; ; attempt++) {
        if (sh(script: "kubectl apply ${DRY_RUN ? '--dry-run=server' : ''} -f ${file}", returnStatus: true) == 0) {
            return
        }
        if (attempt >= retries) {
            error("""RLM.ERROR.START Не удалось применить ${file}, см. вывод kubectl в логе сборки RLM.ERROR.END""")
        }
        println "apply ${file} не прошёл (попытка ${attempt}/${retries}), повтор через ${APPLY_RETRY_SEC}s"
        sleep(time: APPLY_RETRY_SEC, unit: 'SECONDS')
    }
}

/* --- Шаг 1: установка оператора ----------------------------------------------------------------------------------- */
def install_operator() {
    // Namespace создаёт команда стенда — джоба только навешивает лейблы. PSA privileged
    // обязателен: vg-manager работает с /dev на хосте. label --overwrite идемпотентен.
    if (sh(script: "kubectl label namespace ${LVM_NS} ${DRY_RUN ? '--dry-run=server' : ''} --overwrite ${LVM_NS_LABELS}",
           returnStatus: true) != 0) {
        error("""RLM.ERROR.START Не удалось разметить namespace ${LVM_NS}; он должен быть создан на стенде заранее RLM.ERROR.END""")
    }

    // Оператор уже стоит — повторная установка сменила бы ревизию релиза и перезапустила
    // pod, ничего не изменив по существу. Обновление версии чарта делается отдельно.
    // --deployed: релиз в статусе failed/pending дошиваем через helm upgrade --install.
    def release = sh(script: "helm list -n ${LVM_NS} -q --deployed --filter '^${LVM_RELEASE}\$' 2>/dev/null || true",
                     returnStdout: true).trim()

    if (release) {
        println "\n --- JOB_INFO: релиз ${LVM_RELEASE} в ns ${LVM_NS} уже установлен, установка чарта пропущена --- \n"
        sh "helm list -n ${LVM_NS}"
        finalData.operator_action = 'skipped'
    } else if (DRY_RUN) {
        sh "helm template ${LVM_RELEASE} ${CHART_PATH} --namespace ${LVM_NS} > out/lvm-operator-rendered.yaml"
        println "\n --- JOB_INFO: dry-run: чарт отрендерен в out/lvm-operator-rendered.yaml, установка пропущена --- \n"
        finalData.operator_action = 'dry-run'
    } else {
        // Без --wait: ресурсы и GC-настройки чарт хардкодит (5m/50Mi, GOMEMLIMIT=50MiB) и values
        // для них не предусматривает. Патчим до ожидания готовности, чтобы оператор не начал
        // реконсайл LVMCluster с дефолтами и чтобы обошлось одним rollout'ом.
        sh "helm upgrade --install --namespace ${LVM_NS} ${LVM_RELEASE} ${CHART_PATH}"
        finalData.operator_action = 'installed'
    }

    if (DRY_RUN) { return }

    // Оператор держит в памяти все LVMCluster/LVMVolumeGroup*: на сотнях нод × десятках
    // дисков дефолтов чарта не хватает. Патч идемпотентен — на совпадающих значениях
    // kubectl не меняет spec, deployment не перезапускается, поэтому он же чинит
    // установку, оборвавшуюся между helm и патчем.
    def resources = "cpu=${OPERATOR_CPU},memory=${OPERATOR_MEM}"
    sh "kubectl -n ${LVM_NS} set resources deployment/${OPERATOR_DEPLOY} --requests=${resources} --limits=${resources}"
    sh "kubectl -n ${LVM_NS} set env deployment/${OPERATOR_DEPLOY} GOGC=${OPERATOR_GOGC} GOMEMLIMIT=${OPERATOR_GOMEMLIMIT} GOMAXPROCS=${OPERATOR_GOMAXPROCS}"
    sh "kubectl -n ${LVM_NS} rollout status deployment/${OPERATOR_DEPLOY} --timeout=10m"
}

/* --- Шаг 2: LVMCluster --------------------------------------------------------------------------------------------
       StorageClass'ы оператор создаёт сам, асинхронно; джоба их появление не проверяет —
       `get sc` это кластерный ресурс, а прав на него у SA стенда нет. -------------------------------------------- */
def create_lvm_cluster(List devices) {
    // Оператор поддерживает только один CR LVMCluster — чужой не трогаем
    def existing = sh(script: "kubectl -n ${LVM_NS} get lvmclusters.lvm.topolvm.io -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || true",
                      returnStdout: true).trim()
    if (existing && !(existing.split(/\s+/) as List).contains(LVM_CLUSTER)) {
        error("""RLM.ERROR.START В ns ${LVM_NS} уже есть LVMCluster '${existing}'; оператор поддерживает только один CR RLM.ERROR.END""")
    }

    // Сверяем раскладку с тем, что уже описано в CR. Пропавший или переехавший на другой
    // диск deviceClass — это пересоздание VG, то есть потеря данных на нём; такое
    // расхождение (например, нода выпала из авто-дискаверинга) останавливает сценарий.
    def spec = sh(script: "kubectl -n ${LVM_NS} get lvmcluster ${LVM_CLUSTER} -o jsonpath='{.spec.storage.deviceClasses}' 2>/dev/null || true",
                  returnStdout: true).trim()
    def diff = device_diff(devices, spec)

    def broken = []
    for (name in diff.dropped) { broken << "${name} — нет во входных данных" }
    for (name in diff.moved)   { broken << "${name} — сменился диск или нода" }
    if (broken) {
        error("""RLM.ERROR.START LVMCluster ${LVM_CLUSTER} расходится с раскладкой по ${broken.size()} deviceClass'ам (${broken.take(5).join('; ')}); apply пересоздал бы VG и стёр данные на дисках RLM.ERROR.END""")
    }

    if (diff.added) {
        println "\n --- JOB_INFO: применяем LVMCluster: ${diff.added.size()} новых deviceClass'ов к ${diff.total} существующим --- \n"
        kube_apply('out/lvmcluster.yaml', WEBHOOK_APPLY_RETRIES)
        finalData.lvm_cluster_action = diff.total ? 'updated' : 'created'
    } else {
        println "\n --- JOB_INFO: LVMCluster ${LVM_CLUSTER} уже описывает все ${diff.total} deviceClass'ов, apply пропущен --- \n"
        finalData.lvm_cluster_action = 'unchanged'
    }
}

/* --- Шаг 3: PVC --------------------------------------------------------------------------------------------------- */
def create_pvcs(List volumes) {
    // Создаём только недостающие: spec PVC неизменяем, повторный apply существующих
    // в лучшем случае ничего не даст, в худшем — попытается изменить размер.
    def raw = sh(script: "kubectl -n ${OZONE_NS} get pvc --no-headers -o custom-columns=NAME:.metadata.name,SC:.spec.storageClassName,SIZE:.spec.resources.requests.storage 2>/dev/null || true",
                 returnStdout: true).trim()
    def diff = volume_diff(volumes, raw)

    if (diff.wrong) {
        error("""RLM.ERROR.START ${diff.wrong.size()} PVC в ns ${OZONE_NS} уже есть, но с другим StorageClass или размером (${diff.wrong.take(5).join(', ')}); spec PVC неизменяем, расхождение разбирается вручную RLM.ERROR.END""")
    }

    def missing = diff.missing
    finalData.pvc_created = 0
    if (!missing) {
        println "\n --- JOB_INFO: все ${volumes.size()} PVC уже есть в ns ${OZONE_NS}, изменений нет --- \n"
        return
    }

    // Дефолтная квота DropApp запрещает PVC (hard = 0)
    if (PVC_QUOTA) {
        if (PVC_QUOTA < volumes.size()) {
            error("""RLM.ERROR.START pvcQuota=${PVC_QUOTA} меньше числа создаваемых PVC (${volumes.size()}) RLM.ERROR.END""")
        }
        def hard = sh(script: "kubectl -n ${OZONE_NS} get resourcequota ${QUOTA_NAME} -o jsonpath='{.spec.hard.persistentvolumeclaims}' 2>/dev/null || true",
                      returnStdout: true).trim()
        if (hard == PVC_QUOTA.toString()) {
            println "квота PVC в ns ${OZONE_NS} уже ${PVC_QUOTA}, патч не нужен"
        } else if (DRY_RUN) {
            println "dry-run: квота PVC ${hard ?: 'не задана'} → ${PVC_QUOTA}, патч пропущен"
        } else {
            sh "kubectl -n ${OZONE_NS} patch resourcequota ${QUOTA_NAME} -p '{\"spec\":{\"hard\":{\"persistentvolumeclaims\":\"${PVC_QUOTA}\"}}}'"
        }
    }

    println "\n --- JOB_INFO: не хватает ${missing.size()} PVC из ${volumes.size()}, создаём --- \n"
    def files = write_pvc_batches(missing)
    for (int i = 0; i < files.size(); i++) {
        println "applying ${files[i]} (${i + 1}/${files.size()})"
        kube_apply(files[i], 1)
    }
    if (DRY_RUN) { return }
    finalData.pvc_created = missing.size()

    // StorageClass'ы topolvm — WaitForFirstConsumer, Bound появится только с pod'ами ozone
    println "\n --- JOB_INFO: создано ${missing.size()} PVC, всего по раскладке ${volumes.size()}; Pending — норма --- \n"
}

/* --- Отчёт -------------------------------------------------------------------------------------------------------- */
def report(List devices, List volumes) {
    writeFile file: 'out/report.txt', text: """\
Подготовка k8s-кластера к установке Ozone
=========================================
RLM-ID          : ${RLM_ID}
action          : ${ACTION}${DRY_RUN ? ' (dry-run)' : ''}
стенд           : ${K8S_STAND} (${API_URL})
ns ozone        : ${OZONE_NS}
ns оператора    : ${LVM_NS}, LVMCluster ${LVM_CLUSTER}

om  (${OM_NODES.size()}), диск ${OM_DISK_INDEX}, ${OM_PVC_SIZE}:
${OM_NODES.join('\n')}

scm (${SCM_NODES.size()}), диск ${SCM_DISK_INDEX}, ${SCM_PVC_SIZE}:
${SCM_NODES.join('\n')}

datanode (${DN_NODES.size()}), дисков на ноду ${DN_DISK_PATHS.size()}, ${DN_PVC_SIZE}:
${DN_NODES.join('\n')}

deviceClasses   : ${devices.size()}
StorageClass    : lvNN-<nodeShortName> (оператор, без префикса)
PVC             : ${volumes.size()}

Что сделал запуск (шаги идемпотентны, «—» = шаг не выполнялся):
lvm-operator    : ${finalData.operator_action ?: '—'}
LVMCluster      : ${finalData.lvm_cluster_action ?: '—'}
PVC создано     : ${finalData.pvc_created == null ? '—' : finalData.pvc_created}

Дальше: смержить out/ozone-storage-values.yaml в values/values-<stand>.yaml
репозитория ozone-dropapp и запустить деплой чарта ozone.
"""
    println readFile('out/report.txt')
    archiveArtifacts artifacts: 'out/**', fingerprint: true, allowEmptyArchive: true
}

/* ===================================================================================================================
   Состояние сценария
   =================================================================================================================== */

error           = "Непредвиденная ошибка при выполнении сценария"
print_error_tag = true
TEST            = false

ACTIONS      = ['PREPARE_ALL', 'INSTALL_LVM_OPERATOR', 'CREATE_LVM_CLUSTER', 'CREATE_PVC', 'RENDER_ONLY', 'DELETE_PVC']
/* Действиям ниже нужна раскладка «нода × диск», а значит и списки нод */
NODE_ACTIONS = ['PREPARE_ALL', 'CREATE_LVM_CLUSTER', 'CREATE_PVC', 'RENDER_ONLY', 'DELETE_PVC']

/* Техническая обвязка: постоянна для всех стендов, в форму RLM не выносится */
LVM_RELEASE          = 'lvm-operator'
LVM_CLUSTER          = 'ozone'
LVM_NS_LABELS        = 'app.kubernetes.io/name=lvms-operator ' +
                       'pod-security.kubernetes.io/enforce=privileged ' +
                       'pod-security.kubernetes.io/enforce-version=latest ' +
                       'pod-security.kubernetes.io/audit=restricted ' +
                       'pod-security.kubernetes.io/warn=restricted'
CHART_PATH           = 'lvm-operator/deploy/helm'
THIN_POOL            = 'ozone'
THIN_CHUNK_SIZE      = '4Mi'
THIN_SIZE_PERCENT    = 100
THIN_OVERPROVISION   = 10
FS_TYPE              = 'xfs'
QUOTA_NAME           = 'quota'
PVC_OWNER            = 'rlm-prepare-ozone-storage'
OPERATOR_DEPLOY      = 'lvms-operator'
OPERATOR_CPU         = '8'
OPERATOR_MEM         = '8Gi'
OPERATOR_GOGC        = '480'
OPERATOR_GOMEMLIMIT  = '1024MiB'
OPERATOR_GOMAXPROCS  = '8'
PVC_PER_APPLY        = 250
APPLY_RETRY_SEC      = 15
WEBHOOK_APPLY_RETRIES = 8

DEVICES = []
VOLUMES = []

finalData = [
    "cluster"              : null,
    "operator_action"      : null,
    "lvm_cluster"          : null,
    "lvm_cluster_action"   : null,
    "device_classes"       : null,
    "storage_class_prefix" : null,
    "pvc_total"            : null,
    "pvc_created"          : null,
    "om_nodes"             : null,
    "scm_nodes"            : null,
    "datanode_nodes"       : null,
    "values_fragment"      : null
]

node_name = "masterLin"
println(params.data)
JsonData = readJSON text: params.data

println "\n --- JOB_INFO: Jenkins Agent Label: ${node_name} --- \n"


pipeline {
    agent { label node_name }
    parameters {
        booleanParam(name: 'DEBUG', defaultValue: false, description: 'add debug info to log output')
    }
    options {
        timestamps()
        //skipDefaultCheckout()
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
    }
    tools {
        oc 'oc-latest'
    }
    environment {
        KUBECONFIG = "${WORKSPACE}/kube.config"
    }
    stages {
        stage('Get Initial Data') {
            steps {
                script {
                    get_json_data(env.data)
                    if (!TEST) {
                        validate_input()
                        sh 'mkdir -p out'
                    }
                }
            }
        }
        /* RENDER_ONLY сюда не попадает: без явного datanodeNodes его отбивает validate_input */
        stage('Discover nodes') {
            when { expression { return TEST != true && ACTION in NODE_ACTIONS && !DN_NODES } }
            steps {
                script { with_kube('storage') { resolve_datanode_nodes() } }
            }
        }
        stage('Render manifests') {
            when { expression { return TEST != true && ACTION in NODE_ACTIONS } }
            steps {
                script {
                    DEVICES = device_plan()
                    VOLUMES = volume_plan()

                    def lvmcluster = render_lvmcluster(DEVICES)
                    writeFile file: 'out/lvmcluster.yaml',            text: lvmcluster
                    writeFile file: 'out/ozone-storage-values.yaml',  text: render_values()
                    writeFile file: 'out/pvc-names.txt',              text: VOLUMES*.name.join('\n') + '\n'
                    // Манифесты PVC пишет шаг создания — только для недостающих.
                    // RENDER_ONLY до кластера не ходит, поэтому там рендерим всю раскладку.
                    if (ACTION == 'RENDER_ONLY') { write_pvc_batches(VOLUMES) }

                    def sizeKb = (lvmcluster.length() / 1024) as int
                    println "\n --- JOB_INFO: ${DEVICES.size()} deviceClasses (~${sizeKb} KiB), ${VOLUMES.size()} PVC --- \n"
                    if (sizeKb > 1024) {
                        println """
                            ВНИМАНИЕ: манифест LVMCluster больше 1 MiB. Лимит запроса к etcd — 1.5 MiB,
                            а .status растёт вместе со spec. Убедитесь, что у etcd кластера поднят
                            quota-backend-bytes.
                        """
                    }

                    finalData.lvm_cluster          = LVM_CLUSTER
                    finalData.device_classes       = DEVICES.size()
                    finalData.storage_class_prefix = SC_NAME_PREFIX
                    finalData.pvc_total            = VOLUMES.size()
                    finalData.om_nodes             = OM_NODES
                    finalData.scm_nodes            = SCM_NODES
                    finalData.datanode_nodes       = DN_NODES
                    finalData.values_fragment      = 'out/ozone-storage-values.yaml'
                }
            }
        }
        stage('Install LVM operator') {
            when { expression { return TEST != true && ACTION in ['PREPARE_ALL', 'INSTALL_LVM_OPERATOR'] } }
            steps {
                script {
                    withEnv(["PATH+HELM=${tool name: 'helm-v3.14', type: 'com.cloudbees.jenkins.plugins.customtools.CustomTool'}"]) {
                        with_kube('operator') { install_operator() }
                    }
                }
            }
        }
        stage('Create LVMCluster') {
            when { expression { return TEST != true && ACTION in ['PREPARE_ALL', 'CREATE_LVM_CLUSTER'] } }
            steps {
                script { with_kube('storage') { create_lvm_cluster(DEVICES) } }
            }
        }
        stage('Create PVC') {
            when { expression { return TEST != true && ACTION in ['PREPARE_ALL', 'CREATE_PVC'] } }
            steps {
                script { with_kube('pvc') { create_pvcs(VOLUMES) } }
            }
        }
        stage('Delete PVC') {
            when { expression { return TEST != true && ACTION == 'DELETE_PVC' } }
            steps {
                script {
                    with_kube('pvc') {
                        println "\n --- JOB_INFO: удаляем ${VOLUMES.size()} PVC сценария в ns ${OZONE_NS} --- \n"
                        if (!DRY_RUN) {
                            sh "kubectl -n ${OZONE_NS} delete pvc -l app.kubernetes.io/managed-by=${PVC_OWNER} --wait=false"
                        }
                    }
                }
            }
        }
        stage('Report') {
            when { expression { return TEST != true && ACTION in NODE_ACTIONS } }
            steps {
                script { report(DEVICES, VOLUMES) }
            }
        }
    }
    post {
        failure {
            rlm_error()
        }
        success {
            println("""RLM.INFO.START ${JsonOutput.toJson(finalData)} RLM.INFO.END""")
        }
        aborted {
            println("""RLM.ERROR.START $error RLM.ERROR.END""")
        }
        always {
            cleanWs()
        }
    }
}

