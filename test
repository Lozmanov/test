new file mode 100644
index 0000000..0b7becc
--- /dev/null
+++ b/ozone-stack/src/main/resources/stacks/OZONE/2.0.0/services/VECTOR/properties/vector_metrics.yaml.j2
@@ -0,0 +1,68 @@
+---
+data_dir: {{ vector_metrics_data_dir }}
+
+sources:
+  scrape_vector:
+    type: internal_metrics
+    scrape_interval_secs: {{ vector_metrics_scrape_interval_secs }}
+{% for job, endpoint in vector_metrics_targets %}
+  scrape_{{ job }}:
+    type: prometheus_scrape
+    endpoints:
+      - {{ endpoint }}
+    scrape_interval_secs: {{ vector_metrics_scrape_interval_secs }}
+    instance_tag: instance
+    endpoint_tag: endpoint
+{% endfor %}
+
+transforms:
+  label_vector:
+    type: remap
+    inputs:
+      - scrape_vector
+    source: |
+      .tags.job = "vector"
+      .tags.cluster = "{{ cluster_name }}"
+      .tags.host = "{{ hostname }}"
+{% for job, endpoint in vector_metrics_targets %}
+  label_{{ job }}:
+    type: remap
+    inputs:
+      - scrape_{{ job }}
+    source: |
+      .tags.job = "{{ job }}"
+      .tags.cluster = "{{ cluster_name }}"
+      .tags.host = "{{ hostname }}"
+{% endfor %}
+
+sinks:
+  remote_write:
+    type: prometheus_remote_write
+    inputs:
+      - label_*
+    endpoint: {{ vector_metrics_remote_write_url }}
+{% if vector_metrics_tenant_id %}
+    tenant_id: {{ vector_metrics_tenant_id }}
+{% endif %}
+{% if vector_metrics_auth_type == 'basic' %}
+    auth:
+      strategy: basic
+      user: {{ vector_metrics_auth_user }}
+      password: {{ vector_metrics_auth_password }}
+{% elif vector_metrics_auth_type == 'bearer' %}
+    auth:
+      strategy: bearer
+      token: {{ vector_metrics_auth_token }}
+{% endif %}
+    tls:
+      verify_certificate: {{ vector_metrics_tls_verify_certificate }}
+      verify_hostname: {{ vector_metrics_tls_verify_certificate }}
+{% if vector_metrics_tls_ca_file %}
+      ca_file: {{ vector_metrics_tls_ca_file }}
+{% endif %}
+{% if vector_metrics_mtls_enabled %}
+      crt_file: {{ vector_metrics_tls_crt_file }}
+      key_file: {{ vector_metrics_tls_key_file }}
+{% endif %}
+    healthcheck:
+      enabled: false
